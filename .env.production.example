# ========================================
# 3D Print Pro - Production Environment Configuration
# ========================================
# PRODUCTION SETUP INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.production.example .env
# 2. Edit .env with your actual production credentials
# 3. NEVER commit .env to git! (it's already in .gitignore)
# 4. Keep a secure backup of your .env file
# ========================================

# ========================================
# Application Configuration
# ========================================
APP_ENV=production
APP_DEBUG=false
APP_URL=https://3dprint-omsk.ru
APP_NAME="3D Print Pro - Омск"

# ========================================
# Database Configuration
# ========================================
# MySQL credentials for production database
# IMPORTANT: Use strong passwords and restrict privileges
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ch167436_3dprint
DB_USERNAME=ch167436_3dprint
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# ========================================
# Database Admin Credentials (Optional)
# ========================================
# Only required for automated provisioning with scripts/provision-database.php
# Leave empty if provisioning manually via cPanel/PHPMyAdmin
# DB_ADMIN_USER=root
# DB_ADMIN_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD_HERE
# DB_ADMIN_HOST=localhost

# ========================================
# Redis Configuration (Optional)
# ========================================
# Enable Redis for improved caching performance
# Set CACHE_DRIVER=redis if Redis is available
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ========================================
# Cache Configuration
# ========================================
# cache_driver: 'file' (default) or 'redis' (if Redis available)
# cache_ttl: Time-to-live in seconds (300 = 5 minutes)
CACHE_DRIVER=file
CACHE_PREFIX=3dprint_prod_
CACHE_TTL=300

# ========================================
# Session Configuration
# ========================================
# session_lifetime: Minutes before session expires (120 = 2 hours)
# session_secure_cookie: MUST be true in production (requires HTTPS)
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=file

# ========================================
# Email/SMTP Configuration
# ========================================
# Configure SMTP for email notifications
# IMPORTANT: Use app-specific passwords for Gmail/Yandex
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=notify@3dprint-omsk.ru
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
SMTP_ENCRYPTION=ssl
SMTP_FROM_EMAIL=notify@3dprint-omsk.ru
SMTP_FROM_NAME="3D Print Pro"

# Alternative SMTP providers:
# Gmail: smtp.gmail.com, port 587, encryption=tls
# Mailgun: smtp.mailgun.org, port 587, encryption=tls
# SendGrid: smtp.sendgrid.net, port 587, encryption=tls

# ========================================
# Telegram Configuration
# ========================================
# Telegram bot for order notifications
# IMPORTANT: Replace with your actual bot token and chat ID
# See docs/TELEGRAM_INTEGRATION.md for setup instructions
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
TELEGRAM_ENABLED=true

# To create a bot:
# 1. Message @BotFather on Telegram with /newbot
# 2. Follow prompts to get your bot token
# 3. Start a chat with your bot
# 4. Get your chat ID from: https://api.telegram.org/bot{TOKEN}/getUpdates

# ========================================
# Rate Limiting
# ========================================
# Requests per time window per IP address
# Production defaults: 60 requests per 60 seconds
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_TIME_WINDOW=60
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=900

# ========================================
# Security Configuration
# ========================================
# security_headers: Enable security headers (X-Frame-Options, CSP, etc.)
# csrf_token_lifetime: CSRF token validity in seconds
SECURITY_HEADERS_ENABLED=true
CSRF_TOKEN_LIFETIME=3600

# ========================================
# Logging Configuration
# ========================================
# log_level: debug, info, warning, error
# log_max_files: Maximum number of log files to keep
LOG_LEVEL=warning
LOG_MAX_FILES=30
LOG_ROTATION=daily

# ========================================
# Analytics (Optional)
# ========================================
# Google Analytics and Yandex.Metrica tracking IDs
GOOGLE_ANALYTICS_ID=
YANDEX_METRICA_ID=

# ========================================
# Backup Configuration
# ========================================
# backup_retention: Days to keep database backups
# backup_compression: Enable gzip compression for backups
BACKUP_RETENTION=30
BACKUP_COMPRESSION=true

# ========================================
# Notifications Configuration
# ========================================
# Enable/disable specific notification channels
NOTIFICATIONS_TELEGRAM_ENABLED=true
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_TELEGRAM_STATUS_CHANGE=true
NOTIFICATIONS_EMAIL_STATUS_CHANGE=true
NOTIFICATIONS_EMAIL_ADDRESS=admin@3dprint-omsk.ru

# ========================================
# Performance Configuration
# ========================================
# max_upload_size: Maximum file upload size in MB (for portfolio images)
# api_timeout: API request timeout in seconds
MAX_UPLOAD_SIZE=5
API_TIMEOUT=30

# ========================================
# Maintenance Mode (Optional)
# ========================================
# Set to true to enable maintenance mode
# maintenance_message: Message shown to users during maintenance
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Сайт временно недоступен. Ведутся технические работы."

# ========================================
# PRODUCTION SECURITY CHECKLIST
# ========================================
# Before going live, ensure:
# [ ] All placeholder passwords replaced with strong values
# [ ] APP_DEBUG=false
# [ ] SESSION_SECURE_COOKIE=true
# [ ] HTTPS enabled and working
# [ ] Telegram bot token and chat ID configured
# [ ] SMTP credentials tested
# [ ] Database credentials secured (600 permissions on .env)
# [ ] Rate limiting configured appropriately
# [ ] Backup automation scheduled in cron
# [ ] Error logging configured and monitored
# [ ] File permissions set correctly (755 dirs, 644 files, 600 .env)
