{
    "name": "3dprint-pro/platform",
    "description": "3D Print Pro - PHP 7.4+/MySQL web platform with Eloquent ORM integration",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/database": "^8.83",
        "illuminate/events": "^8.83",
        "illuminate/support": "^8.83",
        "illuminate/cache": "^8.83",
        "vlucas/phpdotenv": "^5.4"
    },
    "require-dev": {
        "symfony/var-dumper": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "7.4"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
